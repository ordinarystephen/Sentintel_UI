# Which API implementation to use. Only "mock" exists in this repo; "http" is the
# dev team's (see docs/api-handoff.md).
VITE_API=mock

# Build-time base path when hosting behind a reverse-proxy prefix (Domino-style).
# Must start and end with '/'. Default '/'. Example: VITE_BASE_PATH=/sentinel/
#VITE_BASE_PATH=/

# Dev server only: comma-separated hostnames the dev server will accept when
# proxied (Vite rejects unknown Host headers). Use with: npm run dev -- --host
#VITE_ALLOWED_HOSTS=sentinel.example.internal
