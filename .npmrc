# Enforce the Node floor from package.json "engines" (>= 22.12): npm refuses
# to install on an older runtime instead of warning. See docs/environment.md.
engine-strict=true

# --- Internal registry (target environment/Nexus) -------------------------------------
# TODO: replace with the output of `npm config get registry` run in the
# hosting workspace (docs/environment.md → "Target environment: day one"), then uncomment.
# Until then this stays commented: public npm remains correct for local dev
# and this repo's CI (ratified decision — build round 1).
#registry=https://<NEXUS-HOST>/repository/npm-proxy/
